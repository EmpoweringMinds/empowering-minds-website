
import { Link } from "react-router-dom";
import { useWorkshops } from "../../cms/useWorkshops";
import { getWorkshopDateState } from "../../utils/workshopDates";
import CTAButton from "../ui/CTAButton";

export default function WorkshopPreview() {
  const { workshops, loading, error } = useWorkshops();

  const featuredWorkshop =
    workshops.find(
      (workshop) =>
        getWorkshopDateState(workshop).status === "upcoming"
    ) || workshops[0];

  return (
    <section className="relative overflow-hidden bg-[var(--color-surface-warm)] py-20 sm:py-24 lg:py-28">
      {/* Decorative geometry */}
      <div
        aria-hidden="true"
        className="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full border border-[var(--color-secondary)]/10"
      />

      <div
        aria-hidden="true"
        className="pointer-events-none absolute -right-12 -top-12 h-56 w-56 rounded-full border border-[var(--color-secondary)]/10"
      />

      <div className="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div className="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
          {/* Workshop information */}
          <div className="lg:col-span-7">
            <p className="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--color-secondary)]">
              Workshops & Learning
            </p>

            {loading ? (
              <p className="mt-8 text-[var(--color-text-secondary)]">
                Loading workshops...
              </p>
            ) : error ? (
              <p className="mt-8 text-[var(--color-text-secondary)]">
                Unable to load workshops.
              </p>
            ) : !featuredWorkshop ? (
              <>
                <h2 className="mt-5 text-3xl font-black tracking-tight text-[var(--color-primary)] sm:text-4xl lg:text-5xl">
                  Learning that moves you forward.
                </h2>

                <p className="mt-6 max-w-xl text-base leading-8 text-[var(--color-text-secondary)] sm:text-lg">
                  Explore our workshops and discover practical
                  opportunities to develop your skills.
                </p>

                <div className="mt-8">
                  <CTAButton to="/workshops">
                    Explore All Workshops
                  </CTAButton>
                </div>
              </>
            ) : (
              <>
                <h2 className="mt-5 max-w-2xl text-3xl font-black tracking-tight text-[var(--color-primary)] sm:text-4xl lg:text-5xl">
                  {featuredWorkshop.hero.title ||
                    featuredWorkshop.name}
                </h2>

                <div className="mt-7 h-px w-16 bg-[var(--color-secondary)]" />

                {featuredWorkshop.hero.subtitle && (
                  <p className="mt-7 max-w-xl text-lg font-semibold leading-8 text-[var(--color-primary)] sm:text-xl">
                    {featuredWorkshop.hero.subtitle}
                  </p>
                )}

                {featuredWorkshop.hero.description && (
                  <p className="mt-4 max-w-xl text-base leading-8 text-[var(--color-text-secondary)] sm:text-lg">
                    {featuredWorkshop.hero.description}
                  </p>
                )}

                {/* Workshop details */}
                <div className="mt-8 grid grid-cols-2 gap-6 border-y border-[var(--color-border)] py-6 sm:grid-cols-3">
                  <div>
                    <p className="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-secondary)]">
                      Date
                    </p>

                    <p className="mt-2 font-semibold text-[var(--color-primary)]">
                      {getWorkshopDateState(featuredWorkshop).start
                        ? getWorkshopDateState(featuredWorkshop).start.toLocaleDateString(
                            "en-IN",
                            {
                              day: "numeric",
                              month: "short",
                              year: "numeric",
                            }
                          )
                        : "See details"}
                    </p>
                  </div>

                  <div>
                    <p className="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-secondary)]">
                      Format
                    </p>

                    <p className="mt-2 font-semibold text-[var(--color-primary)]">
                      {featuredWorkshop.format}
                    </p>
                  </div>

                  <div className="col-span-2 sm:col-span-1">
                    <p className="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-secondary)]">
                      Workshop Fee
                    </p>

                    <p className="mt-2 text-xl font-bold text-[var(--color-primary)]">
                      {featuredWorkshop.pricing.currency}{" "}
                      {featuredWorkshop.pricing.regularPrice}
                    </p>
                  </div>
                </div>

                {/* Highlights */}
                {featuredWorkshop.content.highlights?.length > 0 && (
                  <div className="mt-8">
                    <p className="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-secondary)]">
                      What You'll Explore
                    </p>

                    <ul className="mt-4 space-y-3">
                      {featuredWorkshop.content.highlights
                        .slice(0, 3)
                        .map((highlight, index) => (
                          <li
                            key={index}
                            className="flex items-start gap-3 text-sm leading-7 text-[var(--color-text-secondary)] sm:text-base"
                          >
                            <span className="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-secondary)]" />
                            <span>{highlight}</span>
                          </li>
                        ))}
                    </ul>
                  </div>
                )}

                <div className="mt-9 flex flex-wrap items-center gap-4">
                  <CTAButton to={`/workshops/${featuredWorkshop.slug}`}>
                    Discover This Workshop
                  </CTAButton>

                  <Link
                    to="/workshops"
                    className="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] transition-colors hover:text-[var(--color-secondary)]"
                  >
                    View all workshops
                    <span aria-hidden="true">→</span>
                  </Link>
                </div>
              </>
            )}
          </div>

          {/* Visual panel */}
          <div className="lg:col-span-5">
            <div className="relative">
              <div className="absolute inset-6 rounded-full bg-[var(--color-secondary)]/10 blur-3xl" />

              <div className="relative overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-white/80 p-7 shadow-[0_28px_70px_rgba(35,66,78,0.10)] sm:p-10">
                <p className="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--color-secondary)]">
                  Empowering Minds
                </p>

                <div className="mt-8 flex h-48 items-center justify-center rounded-2xl bg-[var(--color-surface-warm)] sm:h-60">
                  <div className="text-center">
                    <div className="mx-auto flex h-20 w-20 items-center justify-center rounded-full border border-[var(--color-secondary)]/20">
                      <span className="text-4xl text-[var(--color-secondary)]">
                        ✳
                      </span>
                    </div>

                    <p className="mt-5 text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)]">
                      Learn. Apply. Grow.
                    </p>
                  </div>
                </div>

                <p className="mt-7 text-2xl font-bold leading-snug text-[var(--color-primary)] sm:text-3xl">
                  Practical learning.
                  <span className="block text-[var(--color-secondary)]">
                    Meaningful progress.
                  </span>
                </p>

                <p className="mt-4 text-sm leading-7 text-[var(--color-text-secondary)]">
                  Discover structured learning experiences designed
                  to help you turn knowledge into action.
                </p>

                <div className="mt-7 border-t border-[var(--color-border)] pt-5">
                  <Link
                    to="/workshops"
                    className="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] transition-colors hover:text-[var(--color-secondary)]"
                  >
                    Explore the workshop directory
                    <span aria-hidden="true">→</span>
                  </Link>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}
